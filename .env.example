# Vibecraft 环境变量配置示例
# 复制此文件为 .env 并修改相应值

# =====================================================
# 端口配置
# =====================================================
VIBECRAFT_PORT=4002
VIBECRAFT_WS_PORT=4003

# =====================================================
# 公网访问配置 (重要!)
# =====================================================
# 允许访问的WebSocket来源，逗号分隔
# 格式: 协议://IP:端口 或 协议://域名
#
# 示例:
# - 本地访问: http://localhost:4002,http://127.0.0.1:4002
# - 公网IP: http://47.96.93.247:4002
# - 域名: https://your-domain.com
# - 混合: http://localhost:4002,http://47.96.93.247:4002,https://your-domain.com
#
# ⚠️ 重要: 如果要从公网访问，必须添加你的公网地址!
ALLOWED_ORIGINS=http://localhost:4002,http://127.0.0.1:4002

# =====================================================
# 调试配置
# =====================================================
# 启用调试日志 (true/false)
VIBECRAFT_DEBUG=false

# =====================================================
# tmux配置
# =====================================================
# tmux会话名称
VIBECRAFT_TMUX_SESSION=claude

# =====================================================
# 语音识别配置 (可选)
# =====================================================
# Deepgram API密钥，用于语音输入功能
# 获取地址: https://console.deepgram.com/
# DEEPGRAM_API_KEY=your_deepgram_api_key_here
